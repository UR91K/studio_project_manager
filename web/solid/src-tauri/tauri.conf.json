{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seula",
  "mainBinaryName": "seula-shell",
  "version": "0.2.0-alpha.2",
  "identifier": "app.seula.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Seula", "width": 1280, "height": 800, "decorations": false, "zoomHotkeysEnabled": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
